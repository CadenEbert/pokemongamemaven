<?import javafx.stage.Stage?>

<Stage xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <scene>
        <Scene>
            <AnchorPane prefHeight="503.0" prefWidth="857.0">
            <children>
               <VBox layoutX="609.0" prefHeight="503.0" prefWidth="247.0">
                  <children>
                     <GridPane prefHeight="509.0" prefWidth="247.0">
                       <columnConstraints>
                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                       </columnConstraints>
                       <rowConstraints>
                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                       </rowConstraints>
                        <children>
                           <Button alignment="BOTTOM_CENTER" mnemonicParsing="false" text="Button" />
                           <ImageView fitHeight="94.0" fitWidth="117.0" pickOnBounds="true" preserveRatio="true" />
                        </children>
                     </GridPane>
                  </children></VBox>
               <HBox layoutY="294.0" prefHeight="212.0" prefWidth="608.0">
                  <children>
                     <FlowPane nodeOrientation="LEFT_TO_RIGHT" prefHeight="212.0" prefWidth="618.0" />
                  </children></HBox>
               <BorderPane prefHeight="260.0" prefWidth="608.0">
                  <center>
                     <ImageView fitHeight="252.0" fitWidth="337.0" onMouseClicked="#countMoney" pickOnBounds="true" preserveRatio="true" BorderPane.alignment="CENTER">
                        <image>
                           <Image url="@pokeball.png" />
                        </image>
                     </ImageView>
                  </center>
                  <bottom>
                     <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Coins: 0" textAlignment="CENTER" BorderPane.alignment="CENTER">
                        <font>
                           <Font name="Power Green" size="36.0" />
                        </font>
                     </Text>
                  </bottom>
               </BorderPane>
            </children></AnchorPane>
        </Scene>
    </scene>
</Stage>
